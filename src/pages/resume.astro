---
import Layout from '../layouts/Layout.astro';
import TechnicalSkills from '../components/TechnicalSkills.astro';
import CertificateCard from '../components/CertificateCard.astro';
import { certificates } from '../data/certificates';

const cvUrl = '/CV_Douglas_Guerrero_ATS.pdf';
---

<Layout
	title="Resume — Douglas Guerrero"
	description="Perfil profesional, habilidades técnicas y formación de Douglas Guerrero, desarrollador full-stack."
>
	<main id="contenido" class="min-h-screen bg-white transition-colors dark:bg-slate-950">
		<section class="relative overflow-hidden border-b border-slate-200 px-5 py-16 transition-colors dark:border-slate-800 sm:px-8 sm:py-24" aria-labelledby="resume-title">
			<div class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_78%_16%,rgba(139,92,246,0.12),transparent_28%)] dark:bg-[radial-gradient(circle_at_78%_16%,rgba(139,92,246,0.11),transparent_30%)]" aria-hidden="true"></div>
			<div class="relative mx-auto w-full max-w-[1160px]">
				<p class="text-sm font-bold uppercase tracking-[0.22em] text-violet-500">Credenciales</p>
				<h1 id="resume-title" class="mt-4 text-5xl font-bold tracking-[-0.05em] text-slate-950 dark:text-white sm:text-7xl">Resume.</h1>
				<p class="mt-3 text-lg font-medium text-slate-500 dark:text-slate-400 sm:text-xl">Mi trayectoria profesional</p>

				<div class="mt-10 ml-auto max-w-[996px] sm:mt-12">
					<p class="max-w-4xl text-base leading-8 text-slate-600 dark:text-slate-300 sm:text-lg">
						Ingeniero de Sistemas y desarrollador full-stack con más de tres años de experiencia construyendo aplicaciones web y empresariales. Especializado en backend con Java, Spring Boot y Node.js, con experiencia en Angular, React, TypeScript, Docker y PostgreSQL.
					</p>

					<div class="mt-7 flex flex-wrap gap-3">
						<a
							href={cvUrl}
							target="_blank"
							rel="noopener noreferrer"
							class="inline-flex items-center justify-center gap-2 rounded-xl bg-slate-950 px-5 py-3.5 font-bold text-white transition hover:-translate-y-0.5 hover:bg-sky-500 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-sky-500 dark:bg-white dark:text-slate-950 dark:hover:bg-sky-400"
						>
							Abrir en nueva pestaña
							<span aria-hidden="true">↗</span>
						</a>
						<a
							href={cvUrl}
							download="CV_Douglas_Guerrero_ATS.pdf"
							class="inline-flex items-center justify-center gap-2 rounded-xl border border-slate-300 bg-white px-5 py-3.5 font-bold text-slate-800 transition hover:-translate-y-0.5 hover:border-sky-400 hover:text-sky-600 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-sky-500 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100 dark:hover:border-sky-400"
						>
							Descargar PDF
							<span aria-hidden="true">↓</span>
						</a>
					</div>

					<div class="mt-7 overflow-hidden rounded-2xl border border-slate-300 bg-slate-200 p-1.5 shadow-[0_24px_70px_rgba(15,23,42,0.14)] transition-colors dark:border-slate-700 dark:bg-slate-800 dark:shadow-[0_24px_70px_rgba(0,0,0,0.38)]">
						<object
							data={`${cvUrl}#view=FitH&toolbar=1&navpanes=0`}
							type="application/pdf"
							class="h-[620px] w-full rounded-xl bg-white sm:h-[780px] lg:h-[900px]"
							aria-label="Currículum de Douglas Guerrero en PDF"
						>
							<div class="flex h-full min-h-96 flex-col items-center justify-center gap-4 bg-white p-8 text-center text-slate-700">
								<p class="font-semibold">Tu navegador no puede mostrar el PDF dentro de la página.</p>
								<a href={cvUrl} target="_blank" rel="noopener noreferrer" class="font-bold text-sky-600 underline underline-offset-4">Abrir el CV en una nueva pestaña</a>
							</div>
						</object>
					</div>
					<p class="mt-3 text-sm text-slate-500 dark:text-slate-400">Si el visor no carga en tu dispositivo, usa “Abrir en nueva pestaña”.</p>
				</div>
			</div>
		</section>

		<section class="px-8 py-4 transition-colors dark:bg-slate-950">
			<div class="mx-auto w-full max-w-[1160px]">
				<TechnicalSkills />
			</div>
		</section>

		<section class="border-t border-slate-200 bg-slate-100 px-8 py-20 transition-colors dark:border-slate-800 dark:bg-slate-900" aria-labelledby="education-title">
			<div class="mx-auto w-full max-w-[1160px]">
				<p class="text-sm font-bold uppercase tracking-[0.2em] text-sky-500">Credenciales</p>
				<h2 id="education-title" class="mt-3 text-4xl font-bold tracking-[-0.035em] text-slate-950 dark:text-white max-sm:text-3xl">Educación y certificados.</h2>
				<p class="mt-4 max-w-xl text-slate-500 dark:text-slate-400">Formación obtenida en instituciones educativas y plataformas digitales.</p>
				<div class="flex w-full flex-wrap justify-center gap-x-12 py-10 max-sm:pt-16">
					{certificates.map((certificate) => <CertificateCard certificate={certificate} />)}
				</div>
			</div>
		</section>
	</main>
</Layout>
