---
import Layout from '../layouts/Layout.astro';

const cvUrl = '/CV_Douglas_Guerrero_ATS.pdf';
export const prerender = true;
---

	<Layout
	title="Resume — Douglas Guerrero"
	description="Perfil profesional y currículum de Douglas Guerrero, desarrollador full-stack."
>
	<main id="contenido" class="min-h-screen bg-slate-100 transition-colors dark:bg-slate-950">
		<section class="relative overflow-hidden border-b border-slate-200 px-5 py-10 transition-colors dark:border-slate-800 sm:px-8 sm:py-12" aria-labelledby="resume-title">
			<div class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_78%_16%,rgba(56,189,248,0.13),transparent_28%)] dark:bg-[radial-gradient(circle_at_78%_16%,rgba(56,189,248,0.11),transparent_30%)]" aria-hidden="true"></div>
			<div data-reveal class="relative mx-auto w-full max-w-[1160px]">
				<h1 id="resume-title" class="text-4xl font-extrabold leading-none tracking-[-0.055em] text-slate-950 dark:text-white sm:text-5xl lg:text-6xl">
					Resume<span class="text-sky-500" aria-hidden="true">.</span>
				</h1>
				<div class="mt-4 h-1 w-16 rounded-full bg-sky-500" aria-hidden="true"></div>
				<p class="mt-4 text-base font-medium text-slate-500 dark:text-slate-400 sm:text-lg" data-i18n-es="Mi trayectoria profesional" data-i18n-en="My professional journey">Mi trayectoria profesional</p>

				<div class="mt-8 ml-auto max-w-[996px] sm:mt-10">
					<p class="max-w-4xl text-base leading-8 text-slate-600 dark:text-slate-300 sm:text-lg" data-i18n-es="Ingeniero de Sistemas y desarrollador full-stack con más de tres años de experiencia construyendo aplicaciones web y empresariales. Especializado en backend con Java, Spring Boot y Node.js, con experiencia en Angular, React, TypeScript, Docker y PostgreSQL." data-i18n-en="Systems Engineer and full-stack developer with over three years of experience building web and enterprise applications. Specialized in backend development with Java, Spring Boot, and Node.js, with experience in Angular, React, TypeScript, Docker, and PostgreSQL.">
						Ingeniero de Sistemas y desarrollador full-stack con más de tres años de experiencia construyendo aplicaciones web y empresariales. Especializado en backend con Java, Spring Boot y Node.js, con experiencia en Angular, React, TypeScript, Docker y PostgreSQL.
					</p>

					<div class="mt-7 flex flex-wrap gap-3">
						<a
							href={cvUrl}
							target="_blank"
							rel="noopener noreferrer"
							class="inline-flex items-center justify-center gap-2 rounded-xl bg-slate-950 px-5 py-3.5 font-bold text-white transition hover:-translate-y-0.5 hover:bg-sky-500 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-sky-500 dark:bg-white dark:text-slate-950 dark:hover:bg-sky-400"
						>
							<span data-i18n-es="Abrir en nueva pestaña" data-i18n-en="Open in new tab">Abrir en nueva pestaña</span>
							<span aria-hidden="true">↗</span>
						</a>
						<a
							href={cvUrl}
							download="CV_Douglas_Guerrero_ATS.pdf"
							class="inline-flex items-center justify-center gap-2 rounded-xl border border-slate-300 bg-white px-5 py-3.5 font-bold text-slate-800 transition hover:-translate-y-0.5 hover:border-sky-400 hover:text-sky-600 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-sky-500 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100 dark:hover:border-sky-400"
						>
							<span data-i18n-es="Descargar PDF" data-i18n-en="Download PDF">Descargar PDF</span>
							<span aria-hidden="true">↓</span>
						</a>
					</div>

					<div class="mt-7 overflow-hidden rounded-2xl border border-slate-300 bg-slate-200 p-1.5 shadow-[0_24px_70px_rgba(15,23,42,0.14)] transition-colors dark:border-slate-700 dark:bg-slate-800 dark:shadow-[0_24px_70px_rgba(0,0,0,0.38)]">
						<object
							data={`${cvUrl}#view=FitH&toolbar=1&navpanes=0`}
							type="application/pdf"
							class="h-[620px] w-full rounded-xl bg-white sm:h-[780px] lg:h-[900px]"
							aria-label="Currículum de Douglas Guerrero en PDF"
							data-i18n-label-es="Currículum de Douglas Guerrero en PDF"
							data-i18n-label-en="Douglas Guerrero's resume in PDF"
						>
							<div class="flex h-full min-h-96 flex-col items-center justify-center gap-4 bg-white p-8 text-center text-slate-700">
								<p class="font-semibold" data-i18n-es="Tu navegador no puede mostrar el PDF dentro de la página." data-i18n-en="Your browser cannot display the PDF on this page.">Tu navegador no puede mostrar el PDF dentro de la página.</p>
								<a href={cvUrl} target="_blank" rel="noopener noreferrer" class="font-bold text-sky-600 underline underline-offset-4" data-i18n-es="Abrir el CV en una nueva pestaña" data-i18n-en="Open the resume in a new tab">Abrir el CV en una nueva pestaña</a>
							</div>
						</object>
					</div>
					<p class="mt-3 text-sm text-slate-500 dark:text-slate-400" data-i18n-es="Si el visor no carga en tu dispositivo, usa “Abrir en nueva pestaña”." data-i18n-en="If the viewer does not load on your device, use “Open in new tab”.">Si el visor no carga en tu dispositivo, usa “Abrir en nueva pestaña”.</p>
				</div>
			</div>
		</section>

	</main>
</Layout>
