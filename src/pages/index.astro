---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import PortfolioChat from '../components/PortfolioChat.astro';
import TechnicalSkills from '../components/TechnicalSkills.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { projects } from '../data/projects';
---

<Layout title="Douglas Guerrero — Desarrollador full-stack">
	<main id="contenido" class="w-full">
		<div class="pointer-events-none fixed inset-0 z-0 mx-auto flex w-full max-w-[1160px] justify-between" aria-hidden="true">
			<div class="hidden h-screen w-px bg-sky-600/5 dark:bg-white/5 xl:block"></div>
			<div class="h-screen w-px bg-sky-600/5 dark:bg-white/5"></div>
			<div class="h-screen w-px bg-sky-600/5 dark:bg-white/5"></div>
			<div class="h-screen w-px bg-sky-600/5 dark:bg-white/5"></div>
			<div class="hidden h-screen w-px bg-sky-600/5 dark:bg-white/5 xl:block"></div>
		</div>

		<Hero />
		<PortfolioChat />

		<section id="sobremi" class="relative bg-white transition-colors dark:bg-slate-950">
			<div class="mx-auto flex w-full max-w-[1160px] flex-col items-center px-8 pb-6 pt-20 sm:pt-24">
				<p class="z-10 text-sm font-bold uppercase tracking-[0.2em] text-sky-500" data-i18n-es="Cómo construyo" data-i18n-en="How I build">Cómo construyo</p>
				<h2 class="z-10 py-5 text-center text-[46px] font-bold tracking-[-0.035em] text-slate-950 dark:text-white max-sm:text-4xl">
					<span data-language-copy="es">Tecnología con <span class="text-sky-400">intención</span>.</span>
					<span data-language-copy="en" hidden>Technology with <span class="text-sky-400">purpose</span>.</span>
				</h2>
				<p class="z-10 w-2/3 py-3 text-center text-xl font-semibold leading-relaxed text-slate-500 dark:text-slate-400 max-md:w-full max-sm:text-lg">
					<span data-language-copy="es">Combino desarrollo <strong>full-stack</strong>, diseño de interfaces y lógica para construir productos intuitivos, dinámicos y eficientes.</span>
					<span data-language-copy="en" hidden>I combine <strong>full-stack</strong> development, interface design, and business logic to build intuitive, dynamic, and efficient products.</span>
				</p>

				<TechnicalSkills />
			</div>
		</section>

		<section class="relative border-y border-slate-200 bg-slate-100 transition-colors dark:border-slate-800 dark:bg-slate-900">
			<div class="mx-auto w-full max-w-[1160px] px-8 py-20 sm:py-24">
				<div class="flex flex-col justify-between gap-5 sm:flex-row sm:items-end">
					<div>
						<p class="text-sm font-bold uppercase tracking-[0.2em] text-sky-500" data-i18n-es="Trabajo seleccionado" data-i18n-en="Selected work">Trabajo seleccionado</p>
						<h2 class="mt-3 text-4xl font-bold tracking-[-0.035em] text-slate-950 dark:text-white max-sm:text-3xl" data-i18n-es="Proyectos destacados." data-i18n-en="Featured projects.">Proyectos destacados.</h2>
					</div>
					<a href="/projects" class="w-fit rounded-full border border-slate-300 bg-white px-5 py-3 text-sm font-bold text-slate-700 transition hover:-translate-y-0.5 hover:border-sky-400 hover:text-sky-600 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-200 dark:hover:border-sky-400">
						<span data-i18n-es="Ver todos los proyectos →" data-i18n-en="View all projects →">Ver todos los proyectos →</span>
					</a>
				</div>
				<div class="flex flex-wrap justify-between gap-y-10 py-10">
					{projects.slice(0, 2).map((project) => <ProjectCard project={project} />)}
				</div>
			</div>
		</section>

		<section class="relative bg-white px-8 py-20 text-center transition-colors dark:bg-slate-950 sm:py-24">
			<p class="text-sm font-bold uppercase tracking-[0.2em] text-violet-500" data-i18n-es="Perfil y formación" data-i18n-en="Background and education">Perfil y formación</p>
			<h2 class="mx-auto mt-4 max-w-2xl text-4xl font-bold tracking-[-0.035em] text-slate-950 dark:text-white sm:text-5xl" data-i18n-es="Conoce el recorrido detrás del trabajo." data-i18n-en="Discover the experience behind the work.">Conoce el recorrido detrás del trabajo.</h2>
			<a href="/resume" class="mt-8 inline-flex rounded-full bg-slate-950 px-6 py-3.5 font-bold text-white transition hover:-translate-y-0.5 hover:bg-sky-500 dark:bg-white dark:text-slate-950 dark:hover:bg-sky-400">
				<span data-i18n-es="Ver resume" data-i18n-en="View resume">Ver resume</span>
			</a>
		</section>
	</main>
</Layout>
