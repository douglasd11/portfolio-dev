---
import { Image } from 'astro:assets';

const { item } = Astro.props;
---

<article class="flex flex-col items-center text-center">
	<p class="w-[60px] border-b-2 border-black py-1 text-xl font-bold max-sm:text-lg">{item.number}</p>
	<Image class="my-5 h-14 w-14 object-contain max-sm:h-12 max-sm:w-12" src={item.image} alt={`Logo de ${item.title}`} width={56} height={56} />
	<h3 class="text-xl font-bold max-sm:text-lg">{item.title}</h3>
	<p class="py-1 text-gray-500 max-sm:text-sm">{item.description}</p>
</article>
