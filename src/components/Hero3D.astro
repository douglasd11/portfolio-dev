		<div class="relative min-h-[390px] w-full lg:min-h-[560px]" data-three-hero>
			<div class="absolute right-0 top-0 z-10 flex items-center gap-2 rounded-full border border-slate-200 bg-white/80 px-3 py-2 text-[11px] font-bold uppercase tracking-[0.16em] text-slate-500 backdrop-blur-sm dark:border-slate-700 dark:bg-slate-900/80 dark:text-slate-300">
				<span class="h-2 w-2 rounded-full bg-emerald-400"></span>
				Three.js · Interactivo
			</div>

			<div class="pointer-events-none absolute inset-8 flex items-center justify-center transition-opacity duration-500" data-scene-fallback aria-hidden="true">
				<div class="hero-fallback-shape"></div>
			</div>

			<canvas class="absolute inset-0 h-full w-full opacity-0 transition-opacity duration-700" data-three-canvas role="img" aria-label="Escultura abstracta interactiva formada por módulos de vidrio azul"></canvas>
			<p class="absolute bottom-2 left-1/2 hidden -translate-x-1/2 whitespace-nowrap text-xs font-semibold text-slate-400 md:block">Mueve el cursor para explorar</p>
		</div>
