</section>

<script>
	import {
		ACESFilmicToneMapping,
		BoxGeometry,
		CircleGeometry,
		DirectionalLight,
		EdgesGeometry,
		Group,
		HemisphereLight,
		LineBasicMaterial,
		LineSegments,
		Mesh,
		MeshBasicMaterial,
		MeshPhysicalMaterial,
		PerspectiveCamera,
		PointLight,
		Scene,
		SRGBColorSpace,
		Vector2,
		WebGLRenderer
	} from 'three';

	const root = document.querySelector<HTMLElement>('[data-three-hero]');
	const canvas = root?.querySelector<HTMLCanvasElement>('[data-three-canvas]');
	const fallback = root?.querySelector<HTMLElement>('[data-scene-fallback]');

	if (root && canvas) {
		let renderer: WebGLRenderer | undefined;
		let frame = 0;
		let visible = true;
		let disposed = false;
		const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

		try {
			renderer = new WebGLRenderer({ canvas, alpha: true, antialias: true, powerPreference: 'high-performance' });
			renderer.setClearColor(0xffffff, 0);
			renderer.outputColorSpace = SRGBColorSpace;
			renderer.toneMapping = ACESFilmicToneMapping;
			renderer.toneMappingExposure = 1.15;

			const scene = new Scene();
			const camera = new PerspectiveCamera(34, 1, 0.1, 100);
			camera.position.set(0, 0.1, 8.4);

			const sculpture = new Group();
			sculpture.rotation.set(-0.15, -0.4, 0.04);
			scene.add(sculpture);

			const glass = new MeshPhysicalMaterial({
				color: 0x8dd8ff,
				metalness: 0.02,
				roughness: 0.12,
				transmission: 0.38,
				transparent: true,
				opacity: 0.48,
				thickness: 0.7,
				clearcoat: 1,
				clearcoatRoughness: 0.08
			});
			const blue = new MeshPhysicalMaterial({
				color: 0x119cff,
				metalness: 0.04,
				roughness: 0.18,
				transparent: true,
				opacity: 0.82,
				clearcoat: 1
			});
			const violet = new MeshPhysicalMaterial({
				color: 0x8b5cf6,
				metalness: 0.04,
				roughness: 0.16,
				transparent: true,
				opacity: 0.9,
				clearcoat: 1
			});

			const boxes = [
				{ position: [0, 0, 0], size: [1.45, 1.45, 1.45], material: blue },
				{ position: [-1.42, 0.15, 0.05], size: [1.25, 1.25, 1.25], material: glass },
				{ position: [1.42, 0.32, -0.05], size: [1.2, 1.2, 1.2], material: glass },
				{ position: [0.22, 1.45, -0.18], size: [1.3, 1.3, 1.3], material: glass },
				{ position: [-0.25, -1.4, 0.12], size: [1.22, 1.22, 1.22], material: glass },
				{ position: [-0.65, 0.75, -1.05], size: [1.1, 1.1, 1.1], material: glass },
				{ position: [1.35, -1.03, 0.72], size: [0.52, 0.9, 0.3], material: violet }
			] as const;

			boxes.forEach(({ position, size, material }) => {
				const geometry = new BoxGeometry(size[0], size[1], size[2]);
				const mesh = new Mesh(geometry, material);
				mesh.position.set(position[0], position[1], position[2]);
				sculpture.add(mesh);

				const edges = new LineSegments(
					new EdgesGeometry(geometry),
					new LineBasicMaterial({ color: material === violet ? 0x7c3aed : 0x258fe5, transparent: true, opacity: material === blue ? 0.55 : 0.38 })
				);
				edges.position.copy(mesh.position);
				sculpture.add(edges);
			});

			const halo = new Mesh(
				new CircleGeometry(2.9, 64),
				new MeshBasicMaterial({ color: 0x38bdf8, transparent: true, opacity: 0.055, depthWrite: false })
			);
			halo.position.set(0.1, -0.2, -1.8);
			scene.add(halo);

			scene.add(new HemisphereLight(0xffffff, 0xcbd5e1, 2.7));
			const keyLight = new DirectionalLight(0xffffff, 5.2);
			keyLight.position.set(4, 6, 7);
			scene.add(keyLight);
			const blueLight = new PointLight(0x38bdf8, 18, 12);
			blueLight.position.set(-3, -1, 4);
			scene.add(blueLight);

			const pointer = new Vector2();
			const target = new Vector2();
			const startedAt = performance.now();

			const resize = () => {
				if (!renderer) return;
				const { width, height } = root.getBoundingClientRect();
				camera.aspect = width / Math.max(height, 1);
				camera.updateProjectionMatrix();
				renderer.setPixelRatio(Math.min(window.devicePixelRatio, window.innerWidth < 768 ? 1.15 : 1.6));
				renderer.setSize(width, height, false);
				renderer.render(scene, camera);
			};

			const render = () => {
				if (!renderer || disposed) return;
				if (!visible) {
					frame = 0;
					return;
				}

				const elapsed = (performance.now() - startedAt) / 1000;
				pointer.lerp(target, 0.045);
				if (!reducedMotion.matches) {
					sculpture.rotation.y = -0.4 + pointer.x * 0.22 + Math.sin(elapsed * 0.32) * 0.08;
					sculpture.rotation.x = -0.15 - pointer.y * 0.14 + Math.cos(elapsed * 0.28) * 0.035;
					sculpture.position.y = Math.sin(elapsed * 0.65) * 0.08;
				}
				renderer.render(scene, camera);
				frame = window.requestAnimationFrame(render);
			};

			const start = () => {
				if (!frame && !reducedMotion.matches) frame = window.requestAnimationFrame(render);
				else if (reducedMotion.matches) renderer?.render(scene, camera);
			};
			const stop = () => {
				window.cancelAnimationFrame(frame);
				frame = 0;
			};

			const handlePointer = (event: PointerEvent) => {
				const bounds = root.getBoundingClientRect();
				target.set(((event.clientX - bounds.left) / bounds.width) * 2 - 1, ((event.clientY - bounds.top) / bounds.height) * 2 - 1);
			};

			const resizeObserver = new ResizeObserver(resize);
			const visibilityObserver = new IntersectionObserver(([entry]) => {
				visible = entry.isIntersecting;
				if (visible) start(); else stop();
			}, { threshold: 0.05 });

			resizeObserver.observe(root);
			visibilityObserver.observe(root);
			root.addEventListener('pointermove', handlePointer, { passive: true });
			reducedMotion.addEventListener('change', () => { stop(); start(); });

			resize();
			fallback?.classList.add('opacity-0');
			canvas.classList.remove('opacity-0');
			start();

			const dispose = () => {
				disposed = true;
				stop();
				resizeObserver.disconnect();
				visibilityObserver.disconnect();
				root.removeEventListener('pointermove', handlePointer);
				scene.traverse((object) => {
					if (object instanceof Mesh || object instanceof LineSegments) {
						object.geometry.dispose();
						const materials = Array.isArray(object.material) ? object.material : [object.material];
						materials.forEach((material) => material.dispose());
					}
				});
				renderer?.dispose();
			};

			document.addEventListener('astro:before-swap', dispose, { once: true });
		} catch {
			canvas.classList.add('hidden');
			fallback?.classList.remove('opacity-0');
		}
	}
</script>

